"use client";

import { useEffect, useMemo, useState } from "react";
import { doc, getDoc } from "firebase/firestore";
import { firestore as db } from "@/lib/firebase";

// -----------------------------------------------------------------------------
// AMPProfileView.tsx
// Route: /amp  (registered in ClientRouter.tsx)
// Creator: Brock Seals  (UID: 9ppSAQTMFchFf8JrACZg0S3OFXj1)
// Event doc path: events/amp-2026
// Aesthetic: mirrors SecondSundayProfileView.tsx
//   - DM Sans
//   - 0.5px borders (border-[0.5px] border-black/10)
//   - Alternating bg sections (white / #F7F5F1)
//   - Uppercase labels, lowercase tracking headers
// -----------------------------------------------------------------------------

type TicketTier = {
  id: string;
  name: string;
  session: "session-1" | "session-2";
  priceCents: number;
  description: string;
  soldOut?: boolean;
  limitPerOrder?: number;
};

type AMPEvent = {
  id: string;
  title: string;
  tagline: string;
  date: string; // ISO
  doorsOpen: string;
  venue: string;
  venueAddress: string;
  heroVideoUrl: string;
  heroPosterUrl: string;
  year: number;
  editionLabel: string; // e.g. "11TH ANNUAL"
  tickets: TicketTier[];
  artistCount: number;
  curator: string;
  curatorHandle: string;
  curatorUid: string;
};

// Fallback data — used if Firestore read fails or during SSG build.
// Update in Firestore at events/amp-2026 for production values.
const FALLBACK_EVENT: AMPEvent = {
  id: "amp-2026",
  title: "Art, Mimosas & Pancakes",
  tagline:
    "A one-night group exhibit celebrating 60+ St. Louis visual artists, live music, vendors, and gourmet pancakes.",
  date: "2026-07-18T14:00:00-05:00",
  doorsOpen: "2:00 PM",
  venue: "The Hawthorn",
  venueAddress: "2231 Washington Ave, St. Louis, MO",
  heroVideoUrl:
    "https://firebasestorage.googleapis.com/v0/b/gemm-8cda2.appspot.com/o/amp%2Famp-hero.mp4?alt=media",
  heroPosterUrl:
    "https://firebasestorage.googleapis.com/v0/b/gemm-8cda2.appspot.com/o/amp%2Famp-poster.jpg?alt=media",
  year: 2026,
  editionLabel: "11TH ANNUAL",
  artistCount: 60,
  curator: "Brock Seals",
  curatorHandle: "palettebyseals",
  curatorUid: "9ppSAQTMFchFf8JrACZg0S3OFXj1",
  tickets: [
    {
      id: "s1-ga",
      name: "Session 1 — General Admission",
      session: "session-1",
      priceCents: 3500,
      description:
        "Family-friendly matinee (2 PM–7 PM). Full gallery access, Little Palettes corner, vendor marketplace, Dan Cakes pancakes.",
      limitPerOrder: 8,
    },
    {
      id: "s1-vip",
      name: "Session 1 — VIP",
      session: "session-1",
      priceCents: 7500,
      description:
        "Early entry at 1 PM, one signed print from Brock Seals, two mimosa vouchers, reserved seating.",
      limitPerOrder: 4,
    },
    {
      id: "s2-ga",
      name: "Session 2 — General Admission",
      session: "session-2",
      priceCents: 4500,
      description:
        "Evening session (8 PM–1 AM). Full gallery access, live musical performances, mimosa bar, late-night vibes.",
      limitPerOrder: 8,
    },
    {
      id: "s2-vip",
      name: "Session 2 — VIP",
      session: "session-2",
      priceCents: 9500,
      description:
        "Early entry at 7 PM, artist meet-and-greet, signed exhibit catalog, premium mimosa service.",
      limitPerOrder: 4,
    },
  ],
};

// -----------------------------------------------------------------------------
// Countdown hook
// -----------------------------------------------------------------------------
function useCountdown(targetIso: string) {
  const [now, setNow] = useState<number>(() => Date.now());
  useEffect(() => {
    const t = setInterval(() => setNow(Date.now()), 1000);
    return () => clearInterval(t);
  }, []);
  return useMemo(() => {
    const diff = new Date(targetIso).getTime() - now;
    if (diff <= 0) return { d: 0, h: 0, m: 0, s: 0, live: true };
    const d = Math.floor(diff / 86_400_000);
    const h = Math.floor((diff % 86_400_000) / 3_600_000);
    const m = Math.floor((diff % 3_600_000) / 60_000);
    const s = Math.floor((diff % 60_000) / 1000);
    return { d, h, m, s, live: false };
  }, [now, targetIso]);
}

// -----------------------------------------------------------------------------
// Main component
// -----------------------------------------------------------------------------
export default function AMPProfileView() {
  const [event, setEvent] = useState<AMPEvent>(FALLBACK_EVENT);
  const [cart, setCart] = useState<Record<string, number>>({});
  const [checkoutLoading, setCheckoutLoading] = useState(false);
  const [checkoutError, setCheckoutError] = useState<string | null>(null);

  // Load event from Firestore
  useEffect(() => {
    (async () => {
      try {
        const snap = await getDoc(doc(db, "events", "amp-2026"));
        if (snap.exists()) {
          setEvent({ ...FALLBACK_EVENT, ...(snap.data() as Partial<AMPEvent>) });
        }
      } catch (err) {
        // Silent fallback — FALLBACK_EVENT is already in state
        console.warn("[AMP] Firestore read failed, using fallback", err);
      }
    })();
  }, []);

  const countdown = useCountdown(event.date);

  const cartTotal = useMemo(() => {
    return Object.entries(cart).reduce((sum, [tid, qty]) => {
      const tier = event.tickets.find((t) => t.id === tid);
      return sum + (tier ? tier.priceCents * qty : 0);
    }, 0);
  }, [cart, event.tickets]);

  const cartCount = useMemo(
    () => Object.values(cart).reduce((a, b) => a + b, 0),
    [cart]
  );

  const updateQty = (tierId: string, delta: number) => {
    setCart((prev) => {
      const tier = event.tickets.find((t) => t.id === tierId);
      const limit = tier?.limitPerOrder ?? 10;
      const next = Math.max(0, Math.min(limit, (prev[tierId] ?? 0) + delta));
      if (next === 0) {
        const { [tierId]: _drop, ...rest } = prev;
        return rest;
      }
      return { ...prev, [tierId]: next };
    });
  };

  const handleCheckout = async () => {
    if (cartCount === 0) return;
    setCheckoutLoading(true);
    setCheckoutError(null);
    try {
      const lineItems = Object.entries(cart).map(([tid, qty]) => {
        const tier = event.tickets.find((t) => t.id === tid)!;
        return {
          tierId: tid,
          name: tier.name,
          priceCents: tier.priceCents,
          quantity: qty,
        };
      });

      const res = await fetch(
        "https://us-central1-gemm-8cda2.cloudfunctions.net/createCheckoutSession",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            creatorUid: event.curatorUid,
            eventId: event.id,
            eventTitle: event.title,
            lineItems,
            successUrl: `${window.location.origin}/amp?checkout=success`,
            cancelUrl: `${window.location.origin}/amp?checkout=cancelled`,
          }),
        }
      );

      if (!res.ok) throw new Error(`Checkout failed (${res.status})`);
      const { url } = await res.json();
      if (!url) throw new Error("No checkout URL returned");
      window.location.href = url;
    } catch (err: any) {
      console.error("[AMP] Checkout error", err);
      setCheckoutError(
        err?.message ?? "Something went wrong. Please try again."
      );
      setCheckoutLoading(false);
    }
  };

  const formatPrice = (cents: number) =>
    `$${(cents / 100).toFixed(cents % 100 === 0 ? 0 : 2)}`;

  const eventDate = new Date(event.date);
  const dateStr = eventDate.toLocaleDateString("en-US", {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
  });

  const session1 = event.tickets.filter((t) => t.session === "session-1");
  const session2 = event.tickets.filter((t) => t.session === "session-2");

  return (
    <main
      className="min-h-screen bg-white text-black"
      style={{ fontFamily: "'DM Sans', system-ui, -apple-system, sans-serif" }}
    >
      {/* =================================================================
          HERO — Fullscreen video background
         ================================================================= */}
      <section className="relative h-screen w-full overflow-hidden">
        <video
          className="absolute inset-0 h-full w-full object-cover"
          src={event.heroVideoUrl}
          poster={event.heroPosterUrl}
          autoPlay
          muted
          loop
          playsInline
        />
        <div className="absolute inset-0 bg-black/40" />

        {/* Top nav bar */}
        <div className="relative z-10 flex items-center justify-between px-6 py-5 sm:px-10">
          <div className="text-[10px] tracking-[0.25em] text-white/90 uppercase">
            {event.editionLabel}
          </div>
          <a
            href="#tickets"
            className="rounded-full border-[0.5px] border-white/60 px-5 py-2 text-[11px] tracking-[0.15em] text-white uppercase transition hover:bg-white hover:text-black"
          >
            Get Tickets
          </a>
        </div>

        {/* Hero center content */}
        <div className="relative z-10 flex h-[calc(100vh-80px)] flex-col items-center justify-center px-6 text-center">
          <h1 className="max-w-4xl text-5xl font-light tracking-tight text-white sm:text-7xl md:text-8xl">
            Art, Mimosas
            <span className="block italic font-normal"> &amp; Pancakes</span>
          </h1>
          <p className="mt-6 max-w-xl text-sm font-light tracking-wide text-white/85 sm:text-base">
            {event.tagline}
          </p>
          <div className="mt-10 flex flex-col items-center gap-2 text-white/80">
            <div className="text-[10px] tracking-[0.3em] uppercase">
              {dateStr}
            </div>
            <div className="text-[10px] tracking-[0.3em] uppercase">
              {event.venue} · {event.venueAddress}
            </div>
          </div>
        </div>

        {/* Countdown strip — bottom of hero */}
        <div className="absolute bottom-0 left-0 right-0 z-10 border-t-[0.5px] border-white/20 bg-black/30 backdrop-blur-sm">
          <div className="mx-auto flex max-w-5xl items-center justify-between px-6 py-4 sm:px-10">
            <div className="text-[10px] tracking-[0.25em] text-white/70 uppercase">
              {countdown.live ? "Happening Now" : "Doors Open In"}
            </div>
            {!countdown.live && (
              <div className="flex gap-6 text-white sm:gap-10">
                {[
                  { label: "Days", v: countdown.d },
                  { label: "Hours", v: countdown.h },
                  { label: "Min", v: countdown.m },
                  { label: "Sec", v: countdown.s },
                ].map((c) => (
                  <div key={c.label} className="text-center">
                    <div className="text-xl font-light tabular-nums sm:text-2xl">
                      {String(c.v).padStart(2, "0")}
                    </div>
                    <div className="text-[9px] tracking-[0.2em] text-white/60 uppercase">
                      {c.label}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>

      {/* =================================================================
          ABOUT — alt bg (#F7F5F1)
         ================================================================= */}
      <section className="border-t-[0.5px] border-black/10 bg-[#F7F5F1] px-6 py-24 sm:px-10 sm:py-32">
        <div className="mx-auto grid max-w-6xl gap-16 md:grid-cols-12">
          <div className="md:col-span-4">
            <div className="text-[10px] tracking-[0.3em] text-black/50 uppercase">
              About
            </div>
            <div className="mt-2 text-[10px] tracking-[0.25em] text-black/40 uppercase">
              Est. 2016 · St. Louis
            </div>
          </div>
          <div className="md:col-span-8">
            <h2 className="text-3xl font-light tracking-tight sm:text-5xl">
              A decade of celebrating St. Louis creativity.
            </h2>
            <p className="mt-8 text-base font-light leading-relaxed text-black/70 sm:text-lg">
              Curated by St. Louis artist {event.curator}, AMP brings together{" "}
              {event.artistCount}+ visual artists, live musical performances,
              local vendors, and gourmet pancakes from Dan Cakes for one
              unforgettable night. What started as a gathering of friends has
              grown into one of the city&rsquo;s premier cultural events —
              showcasing the breadth and depth of the creative community that
              calls St. Louis home.
            </p>
            <div className="mt-12 grid grid-cols-3 gap-6 border-t-[0.5px] border-black/10 pt-12">
              <div>
                <div className="text-3xl font-light sm:text-4xl">
                  {event.artistCount}+
                </div>
                <div className="mt-2 text-[10px] tracking-[0.2em] text-black/50 uppercase">
                  Visual Artists
                </div>
              </div>
              <div>
                <div className="text-3xl font-light sm:text-4xl">10</div>
                <div className="mt-2 text-[10px] tracking-[0.2em] text-black/50 uppercase">
                  Live Acts
                </div>
              </div>
              <div>
                <div className="text-3xl font-light sm:text-4xl">11</div>
                <div className="mt-2 text-[10px] tracking-[0.2em] text-black/50 uppercase">
                  Years Running
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* =================================================================
          SESSIONS — white bg
         ================================================================= */}
      <section
        id="tickets"
        className="border-t-[0.5px] border-black/10 bg-white px-6 py-24 sm:px-10 sm:py-32"
      >
        <div className="mx-auto max-w-6xl">
          <div className="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <div className="text-[10px] tracking-[0.3em] text-black/50 uppercase">
                Tickets
              </div>
              <h2 className="mt-3 text-3xl font-light tracking-tight sm:text-5xl">
                Two sessions. One night.
              </h2>
            </div>
            <div className="text-[11px] font-light text-black/60">
              Tickets sold via Stripe · Refunds until 7 days before event
            </div>
          </div>

          {/* Session 1 */}
          <div className="mt-16 border-t-[0.5px] border-black/10 pt-12">
            <div className="grid gap-10 md:grid-cols-12">
              <div className="md:col-span-4">
                <div className="text-[10px] tracking-[0.3em] text-black/50 uppercase">
                  Session 1
                </div>
                <div className="mt-3 text-2xl font-light sm:text-3xl">
                  Matinee
                </div>
                <div className="mt-2 text-[11px] tracking-[0.15em] text-black/60 uppercase">
                  2:00 PM — 7:00 PM
                </div>
                <p className="mt-6 text-sm font-light leading-relaxed text-black/70">
                  Family-friendly. Features the Little Palettes corner, where
                  youth engage with art professionals. Full vendor marketplace
                  and pancake service open all afternoon.
                </p>
              </div>
              <div className="md:col-span-8">
                <TicketList
                  tiers={session1}
                  cart={cart}
                  onQty={updateQty}
                  formatPrice={formatPrice}
                />
              </div>
            </div>
          </div>

          {/* Session 2 */}
          <div className="mt-16 border-t-[0.5px] border-black/10 pt-12">
            <div className="grid gap-10 md:grid-cols-12">
              <div className="md:col-span-4">
                <div className="text-[10px] tracking-[0.3em] text-black/50 uppercase">
                  Session 2
                </div>
                <div className="mt-3 text-2xl font-light sm:text-3xl">
                  Evening
                </div>
                <div className="mt-2 text-[11px] tracking-[0.15em] text-black/60 uppercase">
                  8:00 PM — 1:00 AM · 21+
                </div>
                <p className="mt-6 text-sm font-light leading-relaxed text-black/70">
                  Live musical performances from 10 St. Louis acts. Full bar,
                  mimosa service, and late-night energy in the gallery.
                </p>
              </div>
              <div className="md:col-span-8">
                <TicketList
                  tiers={session2}
                  cart={cart}
                  onQty={updateQty}
                  formatPrice={formatPrice}
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* =================================================================
          VENUE — alt bg
         ================================================================= */}
      <section className="border-t-[0.5px] border-black/10 bg-[#F7F5F1] px-6 py-24 sm:px-10 sm:py-32">
        <div className="mx-auto grid max-w-6xl gap-16 md:grid-cols-12">
          <div className="md:col-span-4">
            <div className="text-[10px] tracking-[0.3em] text-black/50 uppercase">
              Venue
            </div>
          </div>
          <div className="md:col-span-8">
            <h2 className="text-3xl font-light tracking-tight sm:text-5xl">
              {event.venue}
            </h2>
            <p className="mt-4 text-base font-light text-black/70 sm:text-lg">
              {event.venueAddress}
            </p>
            <div className="mt-10 grid gap-8 border-t-[0.5px] border-black/10 pt-10 sm:grid-cols-2">
              <div>
                <div className="text-[10px] tracking-[0.2em] text-black/50 uppercase">
                  Parking
                </div>
                <p className="mt-2 text-sm font-light text-black/70">
                  Street parking along Washington Ave. Paid lots at 22nd &amp;
                  Locust. Rideshare strongly recommended for Session 2.
                </p>
              </div>
              <div>
                <div className="text-[10px] tracking-[0.2em] text-black/50 uppercase">
                  Accessibility
                </div>
                <p className="mt-2 text-sm font-light text-black/70">
                  Ground-floor gallery with ramp access. ADA restrooms
                  available. Contact us 48 hrs ahead for specific needs.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* =================================================================
          CURATOR — white bg
         ================================================================= */}
      <section className="border-t-[0.5px] border-black/10 bg-white px-6 py-24 sm:px-10 sm:py-32">
        <div className="mx-auto max-w-6xl">
          <div className="grid gap-16 md:grid-cols-12">
            <div className="md:col-span-4">
              <div className="text-[10px] tracking-[0.3em] text-black/50 uppercase">
                Curated By
              </div>
            </div>
            <div className="md:col-span-8">
              <h2 className="text-3xl font-light tracking-tight sm:text-5xl">
                {event.curator}
              </h2>
              <p className="mt-6 text-base font-light leading-relaxed text-black/70 sm:text-lg">
                Artist, muralist, and founder of AMP. Brock has spent over a
                decade building platforms for St. Louis creatives — turning a
                single gallery night into a cultural institution. Explore his
                work, shop prints, and follow what he&rsquo;s building next.
              </p>
              <a
                href={`/${event.curatorHandle}`}
                className="mt-8 inline-flex items-center gap-3 rounded-full border-[0.5px] border-black/20 px-6 py-3 text-[11px] tracking-[0.15em] uppercase transition hover:bg-black hover:text-white"
              >
                Visit Brock&rsquo;s Page
                <span aria-hidden>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* =================================================================
          FOOTER
         ================================================================= */}
      <footer className="border-t-[0.5px] border-black/10 bg-[#F7F5F1] px-6 py-12 sm:px-10">
        <div className="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
          <div>
            <div className="text-[10px] tracking-[0.3em] text-black/50 uppercase">
              Art, Mimosas &amp; Pancakes
            </div>
            <div className="mt-1 text-[11px] text-black/40">
              © {new Date().getFullYear()} · Curated by {event.curator} ·
              Powered by{" "}
              <a href="/" className="underline hover:text-black">
                GEMM
              </a>
            </div>
          </div>
          <div className="flex gap-6 text-[11px] tracking-[0.15em] text-black/60 uppercase">
            <a
              href="https://instagram.com/artmimosaspancakes"
              target="_blank"
              rel="noreferrer"
              className="hover:text-black"
            >
              Instagram
            </a>
            <a href="/privacy" className="hover:text-black">
              Privacy
            </a>
            <a href="/terms" className="hover:text-black">
              Terms
            </a>
          </div>
        </div>
      </footer>

      {/* =================================================================
          STICKY CART BAR — appears when cart has items
         ================================================================= */}
      {cartCount > 0 && (
        <div className="fixed bottom-0 left-0 right-0 z-50 border-t-[0.5px] border-black/15 bg-white/95 backdrop-blur-md">
          <div className="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 sm:px-10">
            <div className="flex items-center gap-6">
              <div>
                <div className="text-[10px] tracking-[0.25em] text-black/50 uppercase">
                  {cartCount} {cartCount === 1 ? "Ticket" : "Tickets"}
                </div>
                <div className="text-xl font-light tabular-nums">
                  {formatPrice(cartTotal)}
                </div>
              </div>
              {checkoutError && (
                <div className="text-xs text-red-600">{checkoutError}</div>
              )}
            </div>
            <button
              onClick={handleCheckout}
              disabled={checkoutLoading}
              className="rounded-full bg-black px-8 py-3 text-[11px] tracking-[0.15em] text-white uppercase transition hover:bg-black/80 disabled:opacity-50"
            >
              {checkoutLoading ? "Redirecting…" : "Checkout"}
            </button>
          </div>
        </div>
      )}
    </main>
  );
}

// -----------------------------------------------------------------------------
// TicketList — subcomponent
// -----------------------------------------------------------------------------
function TicketList({
  tiers,
  cart,
  onQty,
  formatPrice,
}: {
  tiers: TicketTier[];
  cart: Record<string, number>;
  onQty: (id: string, delta: number) => void;
  formatPrice: (cents: number) => string;
}) {
  return (
    <div className="space-y-6">
      {tiers.map((tier) => {
        const qty = cart[tier.id] ?? 0;
        return (
          <div
            key={tier.id}
            className="border-[0.5px] border-black/15 bg-white p-6 transition hover:border-black/30"
          >
            <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div className="flex-1 pr-4">
                <div className="text-base font-normal">{tier.name}</div>
                <div className="mt-1 text-xl font-light tabular-nums">
                  {formatPrice(tier.priceCents)}
                </div>
                <p className="mt-3 text-sm font-light leading-relaxed text-black/70">
                  {tier.description}
                </p>
                {tier.soldOut && (
                  <div className="mt-3 text-[10px] tracking-[0.2em] text-red-600 uppercase">
                    Sold Out
                  </div>
                )}
              </div>
              {!tier.soldOut && (
                <div className="flex items-center gap-3 border-[0.5px] border-black/15 px-2 py-1">
                  <button
                    onClick={() => onQty(tier.id, -1)}
                    disabled={qty === 0}
                    aria-label={`Decrease ${tier.name}`}
                    className="flex h-8 w-8 items-center justify-center text-lg font-light text-black/60 transition hover:text-black disabled:opacity-30"
                  >
                    −
                  </button>
                  <div className="w-6 text-center text-sm tabular-nums">
                    {qty}
                  </div>
                  <button
                    onClick={() => onQty(tier.id, 1)}
                    aria-label={`Increase ${tier.name}`}
                    className="flex h-8 w-8 items-center justify-center text-lg font-light text-black/60 transition hover:text-black"
                  >
                    +
                  </button>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  );
}
